{
  "model_id": "fal-ai/kling-video/o1/image-to-video",
  "display_name": "Kling O1 (First+Last Frame)",
  "description": "Kling O1 - First and Last Frame control with reasoning capabilities for complex transitions",
  "pricing": "$0.112/sec (~$0.56 for 5s video)",
  "processing_time": "~3-5 minutes",
  "image_param_names": {
    "start": "start_image_url",
    "end": "end_image_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt describing the video transition",
      "required": true,
      "default": "A smooth cinematic transition between the two frames",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": [
        "3",
        "4",
        "5",
        "6",
        "7",
        "8",
        "9",
        "10"
      ],
      "default": "5"
    }
  }
}