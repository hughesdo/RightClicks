{
  "model_id": "fal-ai/minimax/hailuo-02/standard/image-to-video",
  "display_name": "MiniMax Hailuo 02 Standard (First+Last Frame)",
  "description": "MiniMax Hailuo 02 Standard - Budget first+last frame video generation",
  "pricing": "$0.15/video",
  "processing_time": "~2 minutes",
  "image_param_names": {
    "start": "image_url",
    "end": "end_image_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt describing the video transition",
      "required": true,
      "default": "A smooth transition between the two frames",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": [
        "6",
        "10"
      ],
      "default": "6"
    },
    "resolution": {
      "type": "dropdown",
      "label": "Resolution",
      "description": "Output video resolution",
      "required": false,
      "options": [
        "512P",
        "768P"
      ],
      "default": "768P"
    },
    "prompt_optimizer": {
      "type": "checkbox",
      "label": "Prompt Optimizer",
      "description": "Let the model refine your prompt automatically",
      "required": false,
      "default": true
    }
  }
}