# RightClicks .gitignore

# Exclude old projects - reference only, not part of new codebase
OldProjects/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
.vscode/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin
$RECYCLE.BIN/

# Mac
.DS_Store

# Application-specific
# Don't ignore these - they're part of the project:
# !install.bat
# !uninstall.bat
# !config.json (default template)

# But do ignore user-specific runtime files:
logs/
*.log

# Test files and experiments (not needed by end users)
testfiles/
TestFiles/

# Icons folder (embedded in application)
Icons/

# Local notes and TODO files (not for public repo)
*.txt
!requirements*.txt
!RVC/requirements*.txt
!RVC/**/*.txt
# Model configuration files needed for build
!wan-flf2v.txt
!first-last-frame-to-video.txt

# Archive files
*.rar
*.zip
*.7z

# RVC Python virtual environment (too large for git - users build their own)
# Ignore everything in venv EXCEPT the pre-built packages that need Visual C++ Build Tools
RVC/venv/*
!RVC/venv/Lib/
RVC/venv/Lib/*
!RVC/venv/Lib/site-packages/
RVC/venv/Lib/site-packages/*
!RVC/venv/Lib/site-packages/fairseq/
!RVC/venv/Lib/site-packages/fairseq-0.12.2.dist-info/
RVC/logs/
RVC/output/

# RVC training models (not needed for inference)
RVC/assets/pretrained/
RVC/assets/pretrained_v2/
RVC/assets/uvr5_weights/

# RVC test audio files
RVC/TestAudios/
RVC/assets/TestAudios/

# Word documents
*.docx

