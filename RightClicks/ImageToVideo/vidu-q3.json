      "required": true,
      "multiline": true,
      "rows": 5,
      "default": ""
    },
    "duration": {
      "type": "number",
      "label": "Duration (seconds)",
      "description": "Length of the generated video.",
      "value_type": "int",
      "required": false,
      "min": 1,
      "max": 15,
      "default": 5
    },
    "resolution": {
      "type": "dropdown",
      "label": "Resolution",
      "description": "360p and 540p are billed at the cheap rate; 720p and 1080p cost 2.2x.",
      "value_type": "string",
      "required": false,
      "options": ["360p", "540p", "720p", "1080p"],
      "default": "720p"
    },
    "audio": {
      "type": "checkbox",
      "label": "Generate audio",
      "description": "Adds a native soundtrack.",
      "value_type": "bool",
      "required": false,
      "default": true
    },
    "seed": {
      "type": "number",
      "label": "Seed (optional)",
      "description": "Leave blank for random. Reuse a seed to reproduce a previous result.",
      "value_type": "int",
      "required": false,
      "min": 0,
      "max": 2147483647
    }
  }
}
