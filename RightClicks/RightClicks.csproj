<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\RightClick-LARGE.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="9.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.9.0" />
  </ItemGroup>

  <!-- Include KaraokeStyles folder in output -->
  <ItemGroup>
    <None Include="KaraokeStyles\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Include model configuration files in output -->
  <ItemGroup>
    <None Include="..\wan-flf2v.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>wan-flf2v.txt</Link>
    </None>
    <None Include="..\first-last-frame-to-video.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>first-last-frame-to-video.txt</Link>
    </None>
  </ItemGroup>

  <!-- Include icon resources (embedded in assembly and copied to output) -->
  <ItemGroup>
    <Resource Include="Resources\RightClick-16x16.ico" />
    <Resource Include="Resources\RightClick-32x32.ico" />
    <Resource Include="Resources\RightClick-LARGE.ico" />
    <Resource Include="Resources\RightClick-LARGE.png" />
    <!-- Also copy to output directory for runtime loading -->
    <None Include="Resources\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Include yt-dlp.exe for video downloading -->
  <ItemGroup>
    <None Include="bin\yt-dlp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>bin\yt-dlp.exe</Link>
    </None>
  </ItemGroup>

  <!--
    Post-build: Copy files to %LOCALAPPDATA%\RightClicks for testing shell extension

    ⚠️ CRITICAL: .NET VERSION CONFLICT - READ BEFORE MODIFYING ⚠️

    This application uses a HYBRID .NET architecture:
    - RightClicks (this project): .NET 8.0
    - RightClicksShellExtension: .NET Framework 4.8 (loaded by Windows Explorer)
    - RightClicksShellInstaller: .NET 8.0

    The shell extension MUST be .NET Framework 4.8 because Windows Explorer is a native
    64-bit process that can only host .NET Framework assemblies (not .NET 8).

    COPY ORDER IS CRITICAL:
    1. First: Copy main app files (including .NET 8 Newtonsoft.Json)
    2. THEN: Copy shell extension files (overwrites with .NET Framework Newtonsoft.Json)

    If the .NET 8 Newtonsoft.Json.dll ends up in the install folder, the shell extension
    will fail with: "Could not load file or assembly 'System.Runtime, Version=6.0.0.0'"

    Symptom: Right-clicking shows only "Open RightClicks..." instead of cascading menus.

    See CLAUDE.md "⚠️ CRITICAL: .NET Version Compatibility" section for full details.
  -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <LocalAppData>$(LOCALAPPDATA)</LocalAppData>
      <TestInstallDir>$(LocalAppData)\RightClicks</TestInstallDir>
      <!-- Use MSBuildProjectDirectory to get the solution root (parent of RightClicks project) -->
      <SolutionRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</SolutionRoot>
    </PropertyGroup>

    <Message Text="Copying RightClicks to $(TestInstallDir) for shell extension testing..." Importance="high" />
    <Message Text="Solution root: $(SolutionRoot)" Importance="high" />

    <!-- Create directory if it doesn't exist -->
    <MakeDir Directories="$(TestInstallDir)" />

    <!-- STEP 1: Copy main executable and dependencies (includes .NET 8 Newtonsoft.Json) -->
    <ItemGroup>
      <FilesToCopy Include="$(OutDir)**\*.*" Exclude="$(OutDir)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(TestInstallDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />

    <!-- STEP 2: Copy shell extension files AFTER main app (overwrites .NET 8 DLLs with .NET Framework versions) -->
    <Copy SourceFiles="$(SolutionRoot)\RightClicksShellExtension\bin\Release\RightClicksShellExtension.dll" DestinationFolder="$(TestInstallDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(SolutionRoot)\RightClicksShellExtension\SharpShell.dll" DestinationFolder="$(TestInstallDir)" SkipUnchangedFiles="true" ContinueOnError="true" />

    <!-- ⚠️ CRITICAL: This MUST come AFTER main app copy to overwrite .NET 8 version with .NET Framework version -->
    <!-- SkipUnchangedFiles="false" forces overwrite even if file sizes match -->
    <Copy SourceFiles="$(SolutionRoot)\RightClicksShellExtension\bin\Release\Newtonsoft.Json.dll" DestinationFolder="$(TestInstallDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" ContinueOnError="true" />

    <!-- Copy shell manager (installer tool) -->
    <Copy SourceFiles="$(SolutionRoot)\RightClicksShellInstaller\bin\Release\net8.0\RightClicksShellManager.exe" DestinationFolder="$(TestInstallDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(SolutionRoot)\RightClicksShellInstaller\bin\Release\net8.0\RightClicksShellManager.dll" DestinationFolder="$(TestInstallDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(SolutionRoot)\RightClicksShellInstaller\bin\Release\net8.0\RightClicksShellManager.runtimeconfig.json" DestinationFolder="$(TestInstallDir)" SkipUnchangedFiles="true" ContinueOnError="true" />

    <Message Text="Files copied to $(TestInstallDir)" Importance="high" />
  </Target>

</Project>
