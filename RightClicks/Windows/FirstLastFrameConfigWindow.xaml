<Window x:Class="RightClicks.Windows.FirstLastFrameConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="First + Last Frame API Config"
        Icon="pack://application:,,,/Resources/RightClick-32x32.ico"
        Height="700"
        Width="900"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Modern Windows 11 style colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E1E1E1"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#605E5C"/>

        <!-- Button style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Image previews -->
            <RowDefinition Height="Auto"/> <!-- Model dropdown -->
            <RowDefinition Height="*"/>    <!-- Scrollable form -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Image Previews -->
        <Border Grid.Row="0" 
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="10,10,10,5"
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- First Frame -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="First Frame"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,10"/>
                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="200"
                            Background="White">
                        <Image x:Name="FirstFrameImage"
                               Stretch="Uniform"
                               Margin="5"/>
                    </Border>
                    <Button x:Name="BrowseFirstFrameButton"
                            Content="Browse..."
                            Margin="0,10,0,0"
                            Click="BrowseFirstFrameButton_Click"/>
                </StackPanel>

                <!-- Arrow -->
                <TextBlock Grid.Column="1"
                           Text="→"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Last Frame -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Last Frame"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,10"/>
                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="200"
                            Background="White">
                        <Image x:Name="LastFrameImage"
                               Stretch="Uniform"
                               Margin="5"/>
                    </Border>
                    <Button x:Name="BrowseLastFrameButton"
                            Content="Browse..."
                            Margin="0,10,0,0"
                            Click="BrowseLastFrameButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Model Selection -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="10,5,10,5"
                Padding="15">
            <StackPanel>
                <TextBlock Text="API Model"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="ModelComboBox"
                          FontSize="14"
                          Padding="8"
                          SelectionChanged="ModelComboBox_SelectionChanged"/>
                <TextBlock x:Name="ModelInfoText"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Dynamic Form (Scrollable) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Margin="10,5,10,5">
            <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="15">
                <StackPanel x:Name="DynamicFormPanel"/>
            </Border>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="3"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="10,5,10,10"
                Padding="15">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"
                        Background="#6C757D"/>
                <Button x:Name="SubmitButton"
                        Content="Submit"
                        Width="100"
                        Click="SubmitButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

