{
  "model_id": "fal-ai/framepack/flf2v",
  "display_name": "Framepack (First+Last Frame)",
  "description": "Framepack - Fast first+last frame to video generation",
  "pricing": "$0.15/video",
  "processing_time": "~1-2 minutes",
  "image_param_names": {
    "start": "image_url",
    "end": "end_image_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt describing the video transition",
      "required": true,
      "default": "A smooth transition between the two frames",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "negative_prompt": {
      "type": "text",
      "label": "Negative Prompt",
      "description": "What to avoid in the generation",
      "required": false,
      "default": "blur, distort, low quality",
      "multiline": false,
      "rows": 1,
      "clear_on_focus": false
    },
    "resolution": {
      "type": "dropdown",
      "label": "Resolution",
      "description": "Output video resolution",
      "required": false,
      "options": [
        "720p",
        "480p"
      ],
      "default": "480p"
    },
    "aspect_ratio": {
      "type": "dropdown",
      "label": "Aspect Ratio",
      "description": "Video aspect ratio",
      "required": false,
      "options": [
        "16:9",
        "9:16"
      ],
      "default": "16:9"
    },
    "num_frames": {
      "type": "slider",
      "label": "Number of Frames",
      "description": "Total frames in the generated video",
      "required": false,
      "default": 240,
      "min": 30,
      "max": 600,
      "step": 30
    },
    "seed": {
      "type": "number",
      "label": "Seed",
      "description": "Random seed for reproducibility (leave empty for random)",
      "required": false,
      "default": "Random",
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  }
}