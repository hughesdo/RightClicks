{
  "model_id": "fal-ai/veo3.1/first-last-frame-to-video",
  "display_name": "Veo 3.1 (First+Last Frame)",
  "description": "Google Veo 3.1 - Premium first+last frame video generation with exceptional quality",
  "pricing": "$0.50/video",
  "processing_time": "~3-5 minutes",
  "image_param_names": {
    "start": "first_frame_url",
    "end": "last_frame_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt to guide video generation",
      "required": true,
      "default": "A smooth cinematic transition between the two frames",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "negative_prompt": {
      "type": "text",
      "label": "Negative Prompt",
      "description": "What to avoid in the generation",
      "required": false,
      "default": "",
      "multiline": false,
      "rows": 1,
      "clear_on_focus": false
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": ["5", "8"],
      "default": "5"
    },
    "aspect_ratio": {
      "type": "dropdown",
      "label": "Aspect Ratio",
      "description": "Video aspect ratio",
      "required": false,
      "options": ["16:9", "9:16", "1:1"],
      "default": "16:9"
    },
    "seed": {
      "type": "number",
      "label": "Seed",
      "description": "Random seed for reproducibility (leave empty for random)",
      "required": false,
      "default": "Random",
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  }
}

