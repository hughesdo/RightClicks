{
  "model_id": "fal-ai/pixverse/v4.5/transition",
  "display_name": "Pixverse v4.5 (Transition)",
  "description": "Pixverse v4.5 Transition - Smooth transitions between start and end frames",
  "pricing": "$0.15/video",
  "processing_time": "~1-2 minutes",
  "image_param_names": {
    "start": "first_frame_image",
    "end": "last_frame_image"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt for the video transition",
      "required": true,
      "default": "A smooth transition between the two images",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "negative_prompt": {
      "type": "text",
      "label": "Negative Prompt",
      "description": "What to avoid in the generation",
      "required": false,
      "default": "",
      "multiline": false,
      "rows": 1,
      "clear_on_focus": false
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": ["4", "6"],
      "default": "4"
    },
    "aspect_ratio": {
      "type": "dropdown",
      "label": "Aspect Ratio",
      "description": "Video aspect ratio",
      "required": false,
      "options": ["16:9", "9:16", "1:1", "4:3", "3:4"],
      "default": "16:9"
    },
    "quality": {
      "type": "dropdown",
      "label": "Quality",
      "description": "Output video quality",
      "required": false,
      "options": ["540p", "720p", "1080p"],
      "default": "720p"
    },
    "seed": {
      "type": "number",
      "label": "Seed",
      "description": "Random seed for reproducibility (leave empty for random)",
      "required": false,
      "default": "Random",
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  }
}

