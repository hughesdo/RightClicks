<UserControl x:Class="RightClicksClipEditor.Controls.WaveformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="800"
             Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Waveform Display with ScrollViewer for horizontal scrolling -->
        <Border Grid.Row="0" Background="#2D2D2D" BorderBrush="#3E3E3E" BorderThickness="1">
            <ScrollViewer x:Name="WaveformScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="WaveformScrollViewer_PreviewMouseWheel">
                <Canvas x:Name="WaveformCanvas" ClipToBounds="True"
                        MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown"
                        MouseMove="WaveformCanvas_MouseMove"
                        MouseLeftButtonUp="WaveformCanvas_MouseLeftButtonUp">

                    <!-- Waveform image will be drawn here -->
                    <Image x:Name="WaveformImage" Stretch="Fill"/>

                    <!-- Selection highlight (between IN and OUT) -->
                    <Rectangle x:Name="SelectionHighlight"
                               Fill="#4CAF5040"
                               Stroke="#4CAF50"
                               StrokeThickness="2"
                               Visibility="Collapsed"/>

                    <!-- IN Marker -->
                    <Canvas x:Name="InMarker" Visibility="Collapsed" Cursor="SizeWE">
                        <Rectangle Width="2" Height="1000" Fill="#4CAF50"/>
                        <TextBlock Text="IN" Foreground="White" FontSize="10" FontWeight="Bold"
                                   Canvas.Left="4" Canvas.Top="2" Background="#4CAF50" Padding="2"/>
                    </Canvas>

                    <!-- OUT Marker -->
                    <Canvas x:Name="OutMarker" Visibility="Collapsed" Cursor="SizeWE">
                        <Rectangle Width="2" Height="1000" Fill="#F44336"/>
                        <TextBlock Text="OUT" Foreground="White" FontSize="10" FontWeight="Bold"
                                   Canvas.Left="4" Canvas.Top="2" Background="#F44336" Padding="2"/>
                    </Canvas>

                    <!-- Playhead -->
                    <Canvas x:Name="Playhead" Cursor="SizeWE">
                        <Rectangle Width="2" Height="1000" Fill="#2196F3"/>
                        <TextBlock x:Name="PlayheadLabel" Text="00:00.000" Foreground="White" FontSize="10"
                                   FontWeight="Bold" Canvas.Left="4" Canvas.Top="2" Background="#2196F3" Padding="2"/>
                    </Canvas>
                </Canvas>
            </ScrollViewer>
        </Border>
        
        <!-- Loading Indicator -->
        <Grid x:Name="LoadingPanel" Grid.Row="0" Background="#CC000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Generating waveform..." Foreground="White" FontSize="16" 
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
            </StackPanel>
        </Grid>
        
        <!-- Zoom Controls -->
        <Border Grid.Row="1" Background="#252525" Padding="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Zoom:" Foreground="#999" VerticalAlignment="Center" Margin="5,0"/>
                <Button Content="-" Width="20" Height="18" Margin="5,0" Click="ZoomOut_Click"
                        ToolTip="Zoom out (Ctrl+Mouse Wheel)"/>
                <TextBlock x:Name="ZoomLevelText" Text="100%" Foreground="White" VerticalAlignment="Center"
                           MinWidth="40" TextAlignment="Center"/>
                <Button Content="+" Width="20" Height="18" Margin="5,0" Click="ZoomIn_Click"
                        ToolTip="Zoom in (Ctrl+Mouse Wheel)"/>
                <Button Content="Fit" Width="30" Height="18" Margin="10,0,5,0" Click="ZoomFit_Click"
                        ToolTip="Fit entire duration"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

