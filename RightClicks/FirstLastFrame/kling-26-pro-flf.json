{
  "model_id": "fal-ai/kling-video/v2.6/pro/image-to-video",
  "display_name": "Kling 2.6 Pro (First+Last Frame)",
  "description": "Kling 2.6 Pro - High quality first to last frame video generation with smooth motion",
  "pricing": "$0.50/video",
  "processing_time": "~2-3 minutes",
  "image_param_names": {
    "start": "start_image_url",
    "end": "end_image_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt describing the video transition",
      "required": true,
      "default": "A smooth cinematic transition between the two frames",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "negative_prompt": {
      "type": "text",
      "label": "Negative Prompt",
      "description": "What to avoid in the generation",
      "required": false,
      "default": "blur, distort, low quality",
      "multiline": false,
      "rows": 1,
      "clear_on_focus": false
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": [
        "5",
        "10"
      ],
      "default": "5"
    },
    "generate_audio": {
      "type": "checkbox",
      "label": "Generate Audio",
      "description": "Generate audio for the video",
      "required": false,
      "default": true
    }
  }
}