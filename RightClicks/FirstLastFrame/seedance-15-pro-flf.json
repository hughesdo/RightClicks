{
  "model_id": "fal-ai/bytedance/seedance/v1.5/pro/image-to-video",
  "display_name": "Seedance 1.5 Pro (First+Last Frame)",
  "description": "Seedance 1.5 Pro - ByteDance's latest model with first and last frame support",
  "pricing": "$0.20/video",
  "processing_time": "~2-3 minutes",
  "image_param_names": {
    "start": "image_url",
    "end": "end_image_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt describing the video transition",
      "required": true,
      "default": "A smooth cinematic transition between the two frames",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": [
        "4",
        "5",
        "6",
        "7",
        "8",
        "9",
        "10",
        "11",
        "12"
      ],
      "default": "5"
    },
    "resolution": {
      "type": "dropdown",
      "label": "Resolution",
      "description": "Output video resolution",
      "required": false,
      "options": [
        "480p",
        "720p",
        "1080p"
      ],
      "default": "720p"
    },
    "aspect_ratio": {
      "type": "dropdown",
      "label": "Aspect Ratio",
      "description": "Video aspect ratio",
      "required": false,
      "options": [
        "21:9",
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16",
        "auto"
      ],
      "default": "16:9"
    },
    "generate_audio": {
      "type": "checkbox",
      "label": "Generate Audio",
      "description": "Generate audio for the video",
      "required": false,
      "default": true
    },
    "seed": {
      "type": "number",
      "label": "Seed",
      "description": "Random seed for reproducibility (leave empty for random)",
      "required": false,
      "default": "Random",
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  }
}