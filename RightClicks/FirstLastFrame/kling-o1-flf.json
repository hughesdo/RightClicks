{
  "model_id": "fal-ai/kling-video/o1/image-to-video",
  "display_name": "Kling O1 (First+Last Frame)",
  "description": "Kling O1 - First and Last Frame control with reasoning capabilities for complex transitions",
  "pricing": "$0.112/sec (~$0.56 for 5s video)",
  "processing_time": "~3-5 minutes",
  "image_param_names": {
    "start": "image_url",
    "end": "tail_image_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt describing the video transition",
      "required": true,
      "default": "A smooth cinematic transition between the two frames",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "negative_prompt": {
      "type": "text",
      "label": "Negative Prompt",
      "description": "What to avoid in the generation",
      "required": false,
      "default": "blur, distort, low quality, static",
      "multiline": false,
      "rows": 1,
      "clear_on_focus": false
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": ["5", "10"],
      "default": "5"
    },
    "aspect_ratio": {
      "type": "dropdown",
      "label": "Aspect Ratio",
      "description": "Video aspect ratio",
      "required": false,
      "options": ["16:9", "9:16", "1:1"],
      "default": "16:9"
    },
    "seed": {
      "type": "number",
      "label": "Seed",
      "description": "Random seed for reproducibility (leave empty for random)",
      "required": false,
      "default": "Random",
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  }
}

