  "description": "Vidu Q3. Cheapest option at low resolutions, good stylised and anime motion. No negative prompt support.",
  "pricing": "$0.07/sec @360p/540p, ~$0.154/sec @720p/1080p (~$0.77 for 5s @720p)",
  "processing_time": "1-4 minutes",
  "image_parameter": "image_url",
  "parameters": {
    "prompt": {
