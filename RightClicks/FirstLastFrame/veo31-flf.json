{
  "model_id": "fal-ai/veo3.1/first-last-frame-to-video",
  "display_name": "Veo 3.1 (First+Last Frame)",
  "description": "Google Veo 3.1 - Premium first+last frame video generation with exceptional quality",
  "pricing": "$0.50/video",
  "processing_time": "~3-5 minutes",
  "image_param_names": {
    "start": "first_frame_url",
    "end": "last_frame_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt describing the video transition",
      "required": true,
      "default": "A smooth cinematic transition between the two frames",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "negative_prompt": {
      "type": "text",
      "label": "Negative Prompt",
      "description": "What to avoid in the generation",
      "required": false,
      "default": "",
      "multiline": false,
      "rows": 1,
      "clear_on_focus": false
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": [
        "4s",
        "6s",
        "8s"
      ],
      "default": "8s"
    },
    "aspect_ratio": {
      "type": "dropdown",
      "label": "Aspect Ratio",
      "description": "Video aspect ratio",
      "required": false,
      "options": [
        "auto",
        "16:9",
        "9:16"
      ],
      "default": "16:9"
    },
    "resolution": {
      "type": "dropdown",
      "label": "Resolution",
      "description": "Output video resolution",
      "required": false,
      "options": [
        "720p",
        "1080p",
        "4k"
      ],
      "default": "720p"
    },
    "generate_audio": {
      "type": "checkbox",
      "label": "Generate Audio",
      "description": "Generate audio for the video",
      "required": false,
      "default": true
    },
    "seed": {
      "type": "number",
      "label": "Seed",
      "description": "Random seed for reproducibility (leave empty for random)",
      "required": false,
      "default": "Random",
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  }
}