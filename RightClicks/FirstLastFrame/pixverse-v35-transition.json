{
  "model_id": "fal-ai/pixverse/v3.5/transition",
  "display_name": "Pixverse v3.5 (Transition)",
  "description": "Pixverse v3.5 Transition - Budget option for transitions between start and end frames",
  "pricing": "$0.10/video",
  "processing_time": "~1 minute",
  "image_param_names": {
    "start": "first_image_url",
    "end": "end_image_url"
  },
  "parameters": {
    "prompt": {
      "type": "text",
      "label": "Prompt",
      "description": "Text prompt describing the video transition",
      "required": true,
      "default": "A smooth transition between the two images",
      "multiline": true,
      "rows": 3,
      "clear_on_focus": true
    },
    "negative_prompt": {
      "type": "text",
      "label": "Negative Prompt",
      "description": "What to avoid in the generation",
      "required": false,
      "default": "",
      "multiline": false,
      "rows": 1,
      "clear_on_focus": false
    },
    "duration": {
      "type": "dropdown",
      "label": "Duration",
      "description": "Video duration in seconds",
      "required": false,
      "options": [
        "5",
        "8"
      ],
      "default": "5"
    },
    "aspect_ratio": {
      "type": "dropdown",
      "label": "Aspect Ratio",
      "description": "Video aspect ratio",
      "required": false,
      "options": [
        "16:9",
        "4:3",
        "1:1",
        "3:4",
        "9:16"
      ],
      "default": "16:9"
    },
    "resolution": {
      "type": "dropdown",
      "label": "Resolution",
      "description": "Output video resolution",
      "required": false,
      "options": [
        "360p",
        "540p",
        "720p",
        "1080p"
      ],
      "default": "720p"
    },
    "seed": {
      "type": "number",
      "label": "Seed",
      "description": "Random seed for reproducibility (leave empty for random)",
      "required": false,
      "default": "Random",
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  }
}